# Formatting rules for every file in this project.
# VS Code applies them on save via the EditorConfig extension
# (recommended in .vscode/extensions.json). See https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
max_line_length = 120

[*.json]
indent_size = 2

[*.md]
# Two trailing spaces mean a line break in Markdown
trim_trailing_whitespace = false
